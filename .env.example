AUDIT_DB_URL=postgres://audit:audit@audit-db:5432/audit
LOG_LEVEL=info
AUDIT_INGEST_API_KEY=change-me-ingest-key
AUDIT_READ_API_KEY=change-me-read-key
AUDIT_AUTH_USER=audit-admin
# Genereer met: docker run --rm python:3.12-slim sh -lc "pip install argon2-cffi && python - <<'PY'\n# from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))\n# PY"
AUDIT_AUTH_PASSWORD_HASH=change-me-argon2id-hash
AUDIT_SESSION_SECRET=change-me-session-secret
AUDIT_SESSION_TTL_SECONDS=1800
AUDIT_ALLOW_UNAUTHENTICATED_READS=false
AUDIT_SESSION_COOKIE_SECURE=true
